rules_version = '2';
// قواعد قاعدة بيانات «منتقيات الشعر».
// المطوّر يُعرَف ببريده الموثّق في حساب جوجل.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isDev() { return signedIn() && request.auth.token.email == 'www774475437@gmail.com' && request.auth.token.email_verified == true; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }
    // المشرفون: يضيفهم المطوّر ببريدهم في config/mods، ولكل واحد صلاحياته.
    function modsList() { return get(/databases/$(database)/documents/config/mods).data.list; }
    function can(p) { return isDev() || (signedIn() && request.auth.token.email_verified == true && request.auth.token.email in modsList() && p in modsList()[request.auth.token.email]); }
    function notBanned() { return !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false)); }

    // سجلّ واحد لكل مستخدم: الاسم والرقم الشخصي والعدادات (قراءة واحدة).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if me(uid);
      // لا يغيّر المستخدم اشتراكه ولا حظره بنفسه.
      allow update: if isDev()
        || (can('حظر') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'grants']))
        // «إيقاف»: إنذار وإيقاف مؤقت فقط، بلا حظر دائم ولا شارات.
        || (can('إيقاف') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grants'])
            && request.resource.data.grants.diff(resource.data.get('grants', {})).affectedKeys().hasOnly(['until', 'reason', 'at', 'warns', 'nWarn', 'inbox']))
        || (me(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plus', 'plusHistory', 'banned', 'grants', 'publicId']));
      allow delete: if isDev();
    }
    // الرقم الشخصي (٧ أرقام) → حساب صاحبه.
    match /ids/{publicId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isDev();
    }
    // الاقتباسات المنشورة.
    match /quotes/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && notBanned();
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']); // الإعجابات
      allow delete: if can('مراجعة') || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // عدد الإعجابات المشترك لكل قصيدة: يقرأه الجميع، ويُزاد فقط دفعةً كل ثلاث ساعات.
    match /likeCounts/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int;
    }
    // اختبارات المعلّم: يقرؤها المعلّم وطلابه.
    match /tests/{id} {
      allow create: if signedIn() && request.resource.data.teacher == request.auth.uid;
      allow read: if signedIn() && (resource.data.teacher == request.auth.uid || request.auth.uid in resource.data.students || isDev());
      allow update: if signedIn() && (resource.data.teacher == request.auth.uid || request.auth.uid in resource.data.students);
    }
    // لوحة الصدارة: يقرؤها الجميع، ويكتب كل واحد نتيجته فقط.
    match /board/{uid} { allow read: if true; allow write: if me(uid); }
    // البلاغات والرسائل وطلبات التصميم: يكتبها المستخدم، ويقرؤها المطوّر.
    match /reports/{id}  { allow create: if signedIn(); allow read, update: if can('حظر') || can('بلاغات'); allow delete: if can('حظر'); }
    match /messages/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if can('رسائل') || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if can('رسائل');
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isDev() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isDev();
    }
    // إعدادات عامة (مثل إظهار الاشتراك) والإحصائيات المجمّعة.
    // مشرف الشواهد (لكل العلماء أو لعالم واحد) يغيّر قائمتي الإظهار والإخفاء فقط.
    function shMod() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email in modsList() && modsList()[request.auth.token.email].hasAny(['شواهد', 'شواهد: ابن القيم', 'شواهد: ابن تيمية', 'شواهد: ابن الجوزي', 'شواهد: ابن باز', 'شواهد: ابن عثيمين', 'كتب الشعر']); }
    match /config/{id} {
      allow read: if true;
      allow write: if isDev() || (id == 'marks' && can('توثيق'));
      allow update: if id == 'marks' && shMod() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shShown', 'shHidden']);
    }
    // المنتدى: رسائل كل يوم في سجلّ واحد. يكتب فيه من يُسمح له الآن، والمشرفون («منتدى») يديرونه.
    function fState() { return get(/databases/$(database)/documents/forum/state).data; }
    function fMod() { return can('منتدى'); }
    function fPlus() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('plus', false) == true; }
    function fMaySend() {
      return signedIn() && request.time.toMillis() < fState().get('openUntil', 0)
        && !(request.auth.uid in fState().get('banned', []))
        && (fState().get('who', 'dev') == 'all' || (fState().get('who', 'dev') == 'plus' && fPlus()));
    }
    function fDay(id) { return id.matches('d[0-9]+_[0-9]+'); }
    match /forum/{id} {
      allow read: if id == 'state' || fDay(id) || fMod();
      // الإعدادات التي للمطوّر وحده لا يغيّرها المشرف.
      allow write: if isDev() || (fMod() && (id != 'state' || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['who', 'openUntil', 'auto', 'gap', 'newbie'])));
      allow create: if fDay(id) && fMaySend() && request.resource.data.msgs.size() == 1;
      allow update: if (fDay(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs'])
          && ((fMaySend() && request.resource.data.msgs.size() == resource.data.msgs.size() + 1)
              // حذف العضو رسالته
              || (signedIn() && request.resource.data.msgs.size() == resource.data.msgs.size() - 1)))
        // قوائم الانتظار والمشكوك فيها والسجلّ: يضيف إليها العضو سطراً، ولا يقرؤها.
        || (id in ['pending', 'sus', 'log'] && signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs'])
          && request.resource.data.msgs.size() == resource.data.msgs.size() + 1);
    }
    // ما يخص عضواً واحداً في المنتدى: الإنذارات والتجميد والرسائل الخاصة من الإشراف.
    match /forum_notes/{uid} {
      allow read: if me(uid) || fMod();
      allow write: if fMod();
      allow create: if me(uid) && !request.resource.data.keys().hasAny(['review']);
      allow update: if me(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['strikes', 'frozenUntil', 'notes', 'seen', 'name'])
        && request.resource.data.get('frozenUntil', 0) >= resource.data.get('frozenUntil', 0);
    }
    // نسخة الحساب الكاملة (خاصة بصاحبها)، وعدّاد الأجهزة التي فتحت التطبيق.
    match /saves/{uid}  { allow read, write: if me(uid); }
    match /visits/{device} { allow create: if true; allow read: if isDev(); }
    match /stats/{id}  { allow read: if isDev(); allow update, create: if signedIn(); }
  }
}
