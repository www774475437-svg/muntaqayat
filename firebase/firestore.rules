rules_version = '2';
// قواعد قاعدة بيانات «منتقيات الشعر».
// المطوّر: ضع رقم حسابك (UID) مكان DEVELOPER_UID بعد أول تسجيل دخول لك.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isDev() { return signedIn() && request.auth.uid == 'DEVELOPER_UID'; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }

    // سجلّ واحد لكل مستخدم: الاسم والرقم الشخصي والعدادات (قراءة واحدة).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if me(uid);
      // لا يغيّر المستخدم اشتراكه ولا حظره بنفسه.
      allow update: if isDev() || (me(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plus', 'plusHistory', 'banned', 'grants', 'publicId']));
      allow delete: if isDev();
    }
    // الرقم الشخصي (٧ أرقام) → حساب صاحبه.
    match /ids/{publicId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isDev();
    }
    // الاقتباسات المنشورة.
    match /quotes/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn(); // الإعجابات
      allow delete: if isDev() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // اختبارات المعلّم: يقرؤها المعلّم وطلابه.
    match /tests/{id} {
      allow create: if signedIn() && request.resource.data.teacher == request.auth.uid;
      allow read: if signedIn() && (resource.data.teacher == request.auth.uid || request.auth.uid in resource.data.students || isDev());
      allow update: if signedIn() && (resource.data.teacher == request.auth.uid || request.auth.uid in resource.data.students);
    }
    // البلاغات والرسائل وطلبات التصميم: يكتبها المستخدم، ويقرؤها المطوّر.
    match /reports/{id}  { allow create: if signedIn(); allow read, update, delete: if isDev(); }
    match /messages/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isDev() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isDev();
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isDev() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isDev();
    }
    // إعدادات عامة (مثل إظهار الاشتراك) والإحصائيات المجمّعة.
    match /config/{id} { allow read: if true; allow write: if isDev(); }
    match /stats/{id}  { allow read: if isDev(); allow update, create: if signedIn(); }
  }
}
